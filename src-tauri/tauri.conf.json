{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Harness",
  "version": "0.2.0",
  "identifier": "com.deepseek.harness",
  "build": {
    "beforeDevCommand": "pnpm --filter @deepseek-ai/dsh-web-frontend run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "",
    "frontendDist": "../apps/web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeepSeek Harness",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "DeepSeek AI",
    "category": "DeveloperTool",
    "shortDescription": "DeepSeek Harness Desktop Workbench",
    "longDescription": "High-performance desktop application for DeepSeek Harness built with Tauri 2.0, Rust, and React.",
    "deb": {
      "depends": [
        "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
        "libgtk-3-0"
      ]
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "nsis": {
      "languages": ["English"],
      "displayLanguageSelector": false,
      "installerIcon": "icons/icon.ico"
    }
  }
}
